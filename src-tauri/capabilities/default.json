{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Izin minimal untuk jendela island: ukuran, posisi, tampil, tutup.",
  "windows": ["island"],
  "permissions": [
    "core:window:allow-set-size",
    "core:window:allow-set-position",
